# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_BUSINESS_PHONE=REPLACE_ME
NEXT_PUBLIC_BUSINESS_EMAIL=hello@REPLACE_ME.com

# Database (Postgres — Vercel Postgres / Neon / Supabase)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/gadget?sslmode=require

# Auth.js v5
AUTH_SECRET=generate-a-long-random-string
AUTH_URL=http://localhost:3000
# Optional: AUTH_TRUST_HOST=true on Vercel

# Admin one-time bootstrap (visit /setup)
ADMIN_BOOTSTRAP_TOKEN=generate-a-long-random-token-min-16-chars

# Resend (magic links + transactional)
RESEND_API_KEY=re_xxx
EMAIL_FROM="Gadget Gets It Done <noreply@YOUR_DOMAIN>"

# Stripe
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx

# Vercel Blob
BLOB_READ_WRITE_TOKEN=vercel_blob_xxx

# Twilio SMS (optional — gated)
SMS_ENABLED=false
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Google Calendar stub (optional)
GOOGLE_CALENDAR_ENABLED=false
GOOGLE_CALENDAR_ID=
